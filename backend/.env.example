# Conexão do banco. Em dev, SQLite em arquivo (padrão abaixo).
# No deploy, troque por Turso/Postgres sem mudar o código, ex.:
#   DATABASE_URL=sqlite+libsql://<host>?authToken=...        (Turso)
#   DATABASE_URL=postgresql+psycopg://user:pass@host/db       (Neon/Postgres)
DATABASE_URL=sqlite:///./sprint_aban.db

# Origens permitidas no CORS (front em dev). Separe por vírgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
